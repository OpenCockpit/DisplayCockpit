screen:
  name: "SetupSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcD;55"
        halign: "center"
        noWrap: "1"
        position: "0,0"
        render: "Label"
        size: "$screen_width,65"
        source: "SetupTitle"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "FdLcDLight;45"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$screen_width,115"
        source: "SetupEntry"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "FdLcDLight;40"
        halign: "center"
        noWrap: "1"
        position: "0,180"
        render: "Label"
        size: "$screen_width,60"
        source: "SetupValue"
        transparent: "1"
        zPosition: "2"
