screen:
  name: "PluginBrowserSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "FdLcDLight;45"
        halign: "center"
        noWrap: "1"
        position: "0,65"
        render: "Label"
        size: "$screen_width,63"
        source: "entry"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "FdLcDLight;40"
        halign: "center"
        position: "0,128"
        render: "Label"
        size: "$screen_width,112"
        source: "desc"
        transparent: "1"
        zPosition: "2"
