screen:
  name: "LanguageWizardSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcD;55"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width,65"
        source: "parent.summarytext"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$screen_width,175"
        source: "parent.summarylangname"
        transparent: "1"
        zPosition: "2"
