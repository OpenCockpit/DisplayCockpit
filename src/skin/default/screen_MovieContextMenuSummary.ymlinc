screen:
  name: "MovieContextMenuSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "FdLcDLight;45"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$screen_width,175"
        source: "selected"
        transparent: "1"
