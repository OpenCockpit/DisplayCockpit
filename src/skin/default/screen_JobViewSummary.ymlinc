screen:
  name: "JobViewSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcD;55"
        halign: "left"
        position: "0,0"
        render: "Label"
        size: "$screen_width,65"
        source: "parent.summary_job_name"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "FdLcD;40"
        halign: "left"
        position: "0,70"
        render: "Label"
        size: "$screen_width,70"
        source: "parent.summary_job_task"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        borderColor: "FdLcdAmber"
        borderWidth: "2"
        position: "0,$screen_height-70"
        render: "Progress"
        size: "$screen_width,70"
        source: "parent.summary_job_progress"
        transparent: "1"
        zPosition: "3"
    - widget:
        font: "FdLcDLight;40"
        foregroundColor: "#888888"
        halign: "center"
        position: "0,$screen_height-70"
        render: "Label"
        size: "$screen_width,70"
        source: "parent.summary_job_progress"
        transparent: "1"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "ProgressToText"
