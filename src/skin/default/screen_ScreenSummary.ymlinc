screen:
  name: "ScreenSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcD;45"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width,$screen_height"
        source: "Title"
        transparent: "1"
