screen:
  name: "TimerEditListSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcD;55"
        halign: "center"
        noWrap: "1"
        position: "0,0"
        render: "Label"
        size: "$screen_width,65"
        source: "service"
        transparent: "1"
        valign: "center"
    - widget:
        font: "FdLcDLight;30"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$screen_width,40"
        source: "name"
        transparent: "1"
        valign: "center"
    - widget:
        font: "FdLcDLight;30"
        halign: "center"
        position: "0,105"
        render: "Label"
        size: "$screen_width,40"
        source: "time"
        transparent: "1"
        valign: "center"
    - widget:
        font: "FdLcDLight;30"
        halign: "center"
        position: "0,145"
        render: "Label"
        size: "$screen_width,40"
        source: "duration"
        transparent: "1"
        valign: "center"
    - widget:
        font: "FdLcDLight;30"
        halign: "center"
        position: "0,185"
        render: "Label"
        size: "$screen_width,40"
        source: "state"
        transparent: "1"
        valign: "center"
