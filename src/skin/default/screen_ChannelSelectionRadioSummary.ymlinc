screen:
  name: "ChannelSelectionRadioSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - widget:
        font: "FdLcDLight;45"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width,$screen_height"
        source: "parent.RdsDecoder"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "RdsInfo"
              text: "RtpText"
