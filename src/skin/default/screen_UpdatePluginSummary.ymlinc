screen:
  name: "UpdatePluginSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
    - xmlinc:
        file: "screenpart_LCDTitle.ymlinc"
    - widget:
        font: "FdLcDLight;45"
        halign: "center"
        position: "0,65"
        render: "Label"
        size: "$screen_width,115"
        source: "parent.package"
        transparent: "1"
    - widget:
        font: "FdLcDLight;40"
        halign: "center"
        position: "0,180"
        render: "Label"
        size: "295,60"
        source: "parent.status"
        transparent: "1"
        valign: "center"
